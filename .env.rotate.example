# .env.rotate.example
#
# Copy this file to .env.rotate.local and fill in NEW_* values for every
# secret you want to rotate. .env.rotate.local is gitignored — never commit it.
#
# Steps:
#   1. Create a new Vercel API token at https://vercel.com/account/tokens
#   2. Get your project ID from https://vercel.com/<team>/<project>/settings
#   3. Regenerate each secret in its upstream service (see notes below)
#   4. Paste the new values below
#   5. Run: npm run rotate-env

# --- Vercel auth (required) ---

# Your NEW Vercel API token (created after revoking the old one)
VERCEL_API_TOKEN=

# Found in Vercel → Project Settings → General → Project ID
VERCEL_PROJECT_ID=

# Only needed if your project lives under a Vercel team
# Found in Vercel → Team Settings → General → Team ID
# VERCEL_TEAM_ID=

# --- New secret values (set only the ones you are rotating) ---

# Neon: Settings → Connection Details → reset password → copy new connection string
NEW_DATABASE_URL=

# OpenAI: https://platform.openai.com/api-keys → delete old key → create new
NEW_OPENAI_API_KEY=

# Choose a strong random password (e.g. openssl rand -base64 32)
NEW_ADMIN_PASSWORD=

# Choose a strong random value (e.g. openssl rand -hex 32)
NEW_INTERNAL_API_KEY=

# The new Vercel API token (same as VERCEL_API_TOKEN above — rotates the stored copy)
NEW_VERCEL_API_TOKEN=
